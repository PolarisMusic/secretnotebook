{
  "name": "@secretnotebook/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "X25519/Ed25519/XChaCha20-Poly1305/Argon2id/HKDF/HMAC wrappers, Safe Word KDF, X3DH handshake",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "libsodium-wrappers-sumo": "^0.7.15"
  },
  "peerDependencies": {
    "react-native-libsodium": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "react-native-libsodium": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@secretnotebook/config-eslint": "workspace:*",
    "@secretnotebook/config-tsconfig": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^20.14.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "react-native-libsodium": "^1.4.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
