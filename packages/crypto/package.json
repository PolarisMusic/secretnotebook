{
  "name": "@secretnotebook/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "X25519/Ed25519/AES-GCM/Argon2id wrappers, Safe Word KDF, X3DH handshake",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
