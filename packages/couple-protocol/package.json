{
  "name": "@secretnotebook/couple-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "CRDT + sync envelope format, Double Ratchet wrappers, BLE pairing transport",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@secretnotebook/crypto": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@secretnotebook/config-eslint": "workspace:*",
    "@secretnotebook/config-tsconfig": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
