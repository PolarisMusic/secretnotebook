{
  "expo": {
    "name": "Us Notes",
    "slug": "secretnotebook",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "secretnotebook",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0a0a0a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.secretnotebook.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID unlocks your connection notebook and confirms pairing.",
        "NSCameraUsageDescription": "The camera is used to scan your partner's pairing QR code.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.secretnotebook.app",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA"]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID unlocks your connection notebook and confirms pairing."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan your partner's pairing QR code."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-android-flag-secure.js",
      "./plugins/with-android-release-signing.js"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "devGrantEntitlement": "0"
    }
  }
}
