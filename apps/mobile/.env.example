# Per-build environment for the mobile app. Metro inlines every
# `EXPO_PUBLIC_*` value at bundle time, so anything in here ends up
# baked into the JS bundle — DO NOT put real secrets in this file.
# Copy to `.env` (or set in your shell / EAS build env) before
# running `expo start` / `expo prebuild` / `eas build`.

# ---------------------------------------------------------------
# API base URL for the moderation API server (apps/api).
#
# Local dev (default): http://localhost:3000 — only reachable from
#   the host running docker-compose and the simulator on that host.
# TestFlight / Internal Track: must be the deployed public host
#   (e.g. https://secretnotebook-api.fly.dev). Real phones can't
#   reach localhost.
# ---------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Dev-only IAP entitlement grant. When `1`, boot installs the
# dev-grant ReceiptBridge + ReceiptValidator pair which caches a
# year-long sentinel entitlement at startup so testers can publish
# without a sandbox IAP purchase.
#
# MUST be `0` for any build that ships to:
#   - external TestFlight testers
#   - the Play production track
#   - the App Store production track
#
# Internal testers (TestFlight internal-testing group, Play Internal
# Track) are the only audience this should be `1` for, until the
# real react-native-iap + server-verify-receipt pipeline lands.
# ---------------------------------------------------------------
EXPO_PUBLIC_DEV_GRANT_ENTITLEMENT=0

# ---------------------------------------------------------------
# Always-on debug overlay during onboarding / boot. When `1`, an
# in-app log panel renders above every screen showing tagged events
# from boot, navigation, button presses, etc. Tap the header to
# collapse it into a thin handle so it doesn't block the UI.
#
# MUST be `0` (or unset) for any build that ships to external
# testers / production — the overlay is for diagnosing first-time
# install issues, not a customer-facing feature.
# ---------------------------------------------------------------
EXPO_PUBLIC_DEBUG_OVERLAY=0
