# Phase 1 API environment example. Copy to .env for local dev.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Required to start the API service in S3+ (posts / devices routes).
# DATABASE_URL=postgres://secretnotebook:dev_only_not_for_prod@localhost:5432/secretnotebook

# Maximum allowed clock drift on signed requests, in seconds.
SIGNATURE_MAX_DRIFT_SECONDS=300

# Per-pubkey rate limit applied across all routes. Falls back to client IP
# when no X-Device-Pubkey header is present (e.g. unsigned requests).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# How long an envelope sits in the connection-channel relay before the GC sweep
# can delete it. 30 days matches the spec; tune down for testing.
RELAY_TTL_DAYS=30

# How long an encrypted media blob (couple-note attachments) is retained before
# it expires. Recipients fetch the blob once and cache it locally; the server
# only ever holds ciphertext. Default is 3 days (short by design — media is an
# ephemeral transfer channel, so the server copy just bridges an offline
# partner). A scheduled GC sweep deletes expired blobs every 6 hours.
BLOB_TTL_DAYS=3

# Max ciphertext bytes accepted per blob upload (route-level limit on
# POST /v1/blobs; the global JSON body limit stays at Fastify's 1 MB default).
# 32 MiB covers a 25 MiB plaintext attachment plus chunked-AEAD framing.
BLOB_MAX_BYTES=33554432

# ---------------------------------------------------------------------------
# Blob storage backend.
#   postgres (default): ciphertext stored inline as BYTEA in the blobs table.
#                       Simplest, but large media grows the Postgres/Fly bill.
#   s3:                 ciphertext stored in an S3-compatible bucket (AWS S3
#                       or Cloudflare R2); only metadata stays in Postgres.
# ---------------------------------------------------------------------------
BLOB_BACKEND=postgres

# Required when BLOB_BACKEND=s3. Example values for Cloudflare R2 (recommended
# — zero egress fees):
#   BLOB_BACKEND=s3
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=secretnotebook-blobs
#   S3_ACCESS_KEY_ID=<r2 access key id>
#   S3_SECRET_ACCESS_KEY=<r2 secret access key>
# For AWS S3 instead: omit S3_ENDPOINT and set S3_REGION to the bucket region
# (e.g. us-east-1). Set S3_FORCE_PATH_STYLE=1 only for S3-compatibles that
# need path-style addressing (MinIO); R2 and AWS do not.
#
# In production these are set as Fly secrets, never committed:
#   fly secrets set BLOB_BACKEND=s3 S3_ENDPOINT=… S3_BUCKET=… \
#     S3_ACCESS_KEY_ID=… S3_SECRET_ACCESS_KEY=… -a polaris-secretnotebook-api
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=0
