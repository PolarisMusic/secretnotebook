{
  "name": "@secretnotebook/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify moderation + relay service",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@secretnotebook/crypto": "workspace:*",
    "@secretnotebook/shared-types": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^2.0.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@secretnotebook/config-eslint": "workspace:*",
    "@secretnotebook/config-tsconfig": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
