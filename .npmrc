link-workspace-packages=true
prefer-workspace-packages=true
auto-install-peers=true
strict-peer-dependencies=false
# React Native modules (notably @op-engineering/op-sqlite) assume an
# npm-style flat node_modules — their podspecs walk `../../../package.json`
# from the install dir. pnpm's default nested/symlinked layout breaks that
# traversal, so `pod install` fails. Force the whole workspace to a hoisted
# layout to satisfy those assumptions; the cost is mild (slightly slower
# installs, a few MB more disk) but unblocks every RN module that does this.
# Per-package `.npmrc` does NOT cover this — pnpm only reads the `.npmrc`
# from the directory where `pnpm install` is invoked, which is the repo root.
node-linker=hoisted
